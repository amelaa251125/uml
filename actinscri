<mxfile host="app.diagrams.net">
  <diagram name="Inscription" id="inscription-activity">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Start -->
        <mxCell id="start" value="Début" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="480" y="40" width="80" height="40" as="geometry"/>
        </mxCell>

        <!-- Fill form -->
        <mxCell id="form" value="Remplir le formulaire d'inscription" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="120" width="280" height="60" as="geometry"/>
        </mxCell>

        <!-- Validate input -->
        <mxCell id="validate" value="Valider les données" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="220" width="240" height="60" as="geometry"/>
        </mxCell>

        <!-- Decision -->
        <mxCell id="check" value="Compte déjà existant ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="420" y="320" width="200" height="100" as="geometry"/>
        </mxCell>

        <!-- Error -->
        <mxCell id="error" value="Afficher erreur / demander correction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="700" y="340" width="260" height="60" as="geometry"/>
        </mxCell>

        <!-- Success -->
        <mxCell id="success" value="Créer le compte utilisateur" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="420" y="460" width="240" height="60" as="geometry"/>
        </mxCell>

        <!-- End -->
        <mxCell id="end" value="Fin" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="480" y="560" width="80" height="40" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="start" target="form">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="form" target="validate">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="validate" target="check">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e4" value="Oui" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="check" target="error">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e5" value="Non" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="check" target="success">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="success" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
